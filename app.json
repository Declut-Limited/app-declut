{
  "expo": {
    "name": "Declut",
    "slug": "declut-app",
    "scheme": "declut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.declut.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.declut.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin/app.plugin.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Declut uses your camera to verify your identity (liveness check) during KYC."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Declut uses your location to show listings near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Declut uses your photo library to upload listing photos and videos.",
          "cameraPermission": "Declut uses your camera to capture listing photos and videos.",
          "microphonePermission": "Declut uses your microphone to record audio for listing videos."
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-video",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86fa85bf-545d-4e2d-964f-80aacf91c051"
      }
    },
    "owner": "declut-company-limited"
  }
}
